# Yandex AI Studio
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_folder_id_here
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1
YANDEX_MODEL=deepseek-v4-flash

# GigaChat
# GIGACHAT_TOKEN — OAuth-клиентские данные (base64 от client_id:client_secret),
# access-токен приложение получает само через OAuth и обновляет автоматически
GIGACHAT_TOKEN=base64(client_id:client_secret)
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat-Pro
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
